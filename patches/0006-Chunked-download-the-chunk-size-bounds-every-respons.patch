From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sergei Sveshnikov <sergei@svesh.dev>
Date: Fri, 30 Oct 2026 15:24:36 +0100
Subject: [PATCH 06/10] Chunked download: the chunk size bounds every response

The 1 MB / 50 messages group limits were constants of their own. Now the
chunk size is the most one response may carry: small messages share a
FETCH while their total stays within it, larger ones go in parts of it;
how many messages come at once is the account's batch size.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/core/src/imap/chunked.rs       | 23 ++++++++---------------
 crates/core/src/imap/chunked_tests.rs | 20 ++++++++++----------
 2 files changed, 18 insertions(+), 25 deletions(-)

diff --git a/crates/core/src/imap/chunked.rs b/crates/core/src/imap/chunked.rs
index 04b00db..6641a78 100644
--- a/crates/core/src/imap/chunked.rs
+++ b/crates/core/src/imap/chunked.rs
@@ -26,8 +26,9 @@
 //! on its own, in parts of `BODY.PEEK[]<offset.length>`, as Thunderbird does
 //! (`mail.imap.chunk_size`, 136 KB by default): small responses, steady
 //! traffic, and a dropped connection costs one part instead of a batch.
-//! Messages no larger than a part share one FETCH (up to `GROUP_BYTES`), so
-//! ordinary mail costs a few round trips per batch, not one per message.
+//! The chunk size is the most one response may carry: small messages share
+//! one FETCH while their total stays within it, so ordinary mail costs a few
+//! round trips per batch, not one per message.
 
 use std::sync::LazyLock;
 
@@ -191,13 +192,6 @@ async fn fetch_parts(
 pub type Progress<'a> =
     Option<&'a (dyn Fn(u64, Option<f64>, Option<f64>) -> BichonResult<()> + Send + Sync)>;
 
-/// Small messages share one FETCH while their bodies add up to at most this
-/// many bytes: a few round trips instead of one per message, and responses
-/// still small enough for servers that drop large ones.
-pub const GROUP_BYTES: u64 = 1024 * 1024;
-/// At most this many messages per shared FETCH.
-pub const GROUP_MAX: usize = 50;
-
 /// A warning in the running session's state (the UI shows it). Core unit
 /// tests have no store: there it is only logged.
 #[cfg(not(test))]
@@ -222,9 +216,10 @@ pub enum Step {
     Single(u32, u32),
 }
 
-/// Messages up to `chunk` bytes are grouped (up to `GROUP_BYTES` and
-/// `GROUP_MAX` per group); larger ones and those of unknown size (0) go
-/// alone, in parts. Order is kept within each kind.
+/// `chunk` is the most one response may carry. Messages up to it are grouped
+/// while the group's total stays within it; larger ones and those of unknown
+/// size (0) go alone, in parts of `chunk`. How many messages come at once is
+/// the account's batch size. Order is kept within each kind.
 pub fn plan_steps(messages: &[(u32, u32)], chunk: u32) -> Vec<Step> {
     let mut steps = Vec::new();
     let mut group: Vec<(u32, u32)> = Vec::new();
@@ -234,9 +229,7 @@ pub fn plan_steps(messages: &[(u32, u32)], chunk: u32) -> Vec<Step> {
             steps.push(Step::Single(uid, size));
             continue;
         }
-        if !group.is_empty()
-            && (group_bytes + u64::from(size) > GROUP_BYTES || group.len() >= GROUP_MAX)
-        {
+        if !group.is_empty() && group_bytes + u64::from(size) > u64::from(chunk) {
             steps.push(Step::Group(std::mem::take(&mut group)));
             group_bytes = 0;
         }
diff --git a/crates/core/src/imap/chunked_tests.rs b/crates/core/src/imap/chunked_tests.rs
index c1056ce..44d9f76 100644
--- a/crates/core/src/imap/chunked_tests.rs
+++ b/crates/core/src/imap/chunked_tests.rs
@@ -217,31 +217,31 @@ async fn retrieve_skips_gone_messages_and_stops_when_cancelled() {
 #[test]
 fn small_messages_are_grouped_large_ones_go_alone() {
     let chunk = 100;
-    let steps = plan_steps(&[(1, 10), (2, 200), (3, 0), (4, 100), (5, 50)], chunk);
+    let steps = plan_steps(&[(1, 10), (2, 200), (3, 0), (4, 30), (5, 50)], chunk);
     assert_eq!(
         steps,
         vec![
             Step::Single(2, 200),
             Step::Single(3, 0),
-            Step::Group(vec![(1, 10), (4, 100), (5, 50)]),
+            Step::Group(vec![(1, 10), (4, 30), (5, 50)]),
         ]
     );
 
-    // A group closes at GROUP_BYTES ...
-    let half = (GROUP_BYTES / 2) as u32;
-    let steps = plan_steps(&[(1, half), (2, half), (3, 1)], half);
+    // A group's total stays within the chunk size: a response is never
+    // larger than one part.
+    let steps = plan_steps(&[(1, 60), (2, 40), (3, 1), (4, 100)], chunk);
     assert_eq!(
         steps,
         vec![
-            Step::Group(vec![(1, half), (2, half)]),
-            Step::Group(vec![(3, 1)])
+            Step::Group(vec![(1, 60), (2, 40)]),
+            Step::Group(vec![(3, 1)]),
+            Step::Group(vec![(4, 100)]),
         ]
     );
-    // ... and at GROUP_MAX messages.
-    let many: Vec<(u32, u32)> = (1..=GROUP_MAX as u32 + 1).map(|uid| (uid, 1)).collect();
+    // Many tiny messages: as many per group as fit.
+    let many: Vec<(u32, u32)> = (1..=150).map(|uid| (uid, 1)).collect();
     let steps = plan_steps(&many, chunk);
     assert_eq!(steps.len(), 2);
-    assert!(matches!(&steps[1], Step::Group(g) if g == &vec![(GROUP_MAX as u32 + 1, 1)]));
     assert!(plan_steps(&[], chunk).is_empty());
 }
 
