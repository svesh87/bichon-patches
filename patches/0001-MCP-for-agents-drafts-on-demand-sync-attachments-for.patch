+        .await
+        .unwrap_err()
+        .contains("not known"));
+    MailBox::batch_upsert(&[MailBox {
+        id: account_id ^ 0x5eed,
+        account_id,
+        name: "Drafts".into(),
+        delimiter: Some("/".into()),
+        ..Default::default()
+    }])
+    .unwrap();
+    let folder = append_draft(account_id, Some("Drafts"), b"Subject: x\r\n\r\ny")
+        .await
+        .unwrap();
