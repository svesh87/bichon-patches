     session: &mut Session<Box<dyn SessionStream>>,
     uid: u32,
     size: u32,
     chunk: u32,
+) -> BichonResult<Option<(Vec<u8>, i64)>> {
+    if let Some(found) = fetch_parts(session, uid, size, chunk).await? {
+        return Ok(Some(found));
