+//! svesh: service accounts (`bichon_core::users::service`).
+
+use bichon_core::token::TokenType;
+use bichon_core::users::payload::UserUpdateRequest;
+use bichon_core::users::service::{self, ServiceAccountCreateRequest};
+use bichon_core::users::{UserModel, DEFAULT_ADMIN_USER_ID};
+use poem::test::TestClient;
+use serde_json::{json, Value};
+
+use super::{admin_token, build_api_route, setup};
+
+const ADMIN_ROLE_ID: u64 = 100_000_000_000_000;
+
+fn client() -> TestClient<impl poem::Endpoint> {
+    TestClient::new(build_api_route()).default_header("X-Forwarded-For", "127.0.0.1")
+}
+
+async fn login(username: &str, password: &str) -> Value {
+    let route = poem::Route::new().at("/api/login", poem::post(crate::rest::public::login::login));
+    let resp = TestClient::new(route)
+        .post("/api/login")
+        .header("X-Forwarded-For", "127.0.0.1")
+        .body_json(&json!({ "username": username, "password": password }))
+        .send()
+        .await;
+    resp.0.into_body().into_json().await.unwrap_or(Value::Null)
+}
+
+#[tokio::test]
+async fn service_account_lifecycle() {
+    setup().await;
+    let admin = format!("Bearer {}", admin_token().await);
+    let cli = client();
+
+    let resp = cli
+        .post("/api/v1/service-accounts")
+        .header("Authorization", &admin)
+        .body_json(&json!({ "username": "svc-agent", "description": "MCP agent" }))
+        .send()
+        .await;
+    resp.assert_status_is_ok();
+    let view: Value = resp.json().await.value().deserialize();
+    assert_eq!(view["service_account"], json!(true));
+    assert_eq!(view["email"], json!(""));
+    assert_eq!(view["password"], Value::Null);
+    let id = view["id"].as_u64().unwrap();
+
+    // The name is taken now.
+    let resp = cli
+        .post("/api/v1/service-accounts")
+        .header("Authorization", &admin)
+        .body_json(&json!({ "username": "svc-agent" }))
+        .send()
+        .await;
+    assert!(!resp.0.status().is_success());
+
+    // No WebUI token was created with it; an API token is issued by the admin.
+    assert!(
+        bichon_core::token::AccessTokenModel::get_user_webui_token(id)
+            .unwrap()
+            .is_none()
+    );
+    let resp = cli
+        .post("/api/v1/access-token")
+        .header("Authorization", &admin)
+        .body_json(&json!({ "name": "agent", "user_id": id }))
+        .send()
+        .await;
+    resp.assert_status_is_ok();
+    let token = resp.0.into_body().into_string().await.unwrap();
+
+    let resp = cli
+        .get("/api/v1/current-user")
+        .header("Authorization", format!("Bearer {token}"))
+        .send()
+        .await;
+    resp.assert_status_is_ok();
+    let me: Value = resp.json().await.value().deserialize();
+    assert_eq!(me["username"], json!("svc-agent"));
+
+    // No login: neither by name nor by its empty e-mail.
+    for name in ["svc-agent", ""] {
+        let result = login(name, "whatever-123").await;
+        assert_eq!(result["success"], json!(false), "{name}: {result}");
+    }
+    let result = login("svc-agent", "x").await;
+    assert!(result["error_message"]
+        .as_str()
+        .unwrap_or_default()
+        .contains("service account"));
+
+    // A password or an e-mail cannot be set, other fields can.
+    let resp = cli
+        .post(format!("/api/v1/users/{id}"))
+        .header("Authorization", &admin)
+        .body_json(&json!({ "password": "secret-password" }))
+        .send()
+        .await;
+    assert!(!resp.0.status().is_success());
+    let resp = cli
+        .post(format!("/api/v1/users/{id}"))
+        .header("Authorization", &admin)
+        .body_json(&json!({ "email": "svc@example.com" }))
+        .send()
+        .await;
+    assert!(!resp.0.status().is_success());
+    let resp = cli
+        .post(format!("/api/v1/users/{id}"))
+        .header("Authorization", &admin)
+        .body_json(&json!({ "description": "still MCP" }))
+        .send()
+        .await;
+    resp.assert_status_is_ok();
+
+    let resp = cli
+        .delete(format!("/api/v1/users/{id}"))
+        .header("Authorization", &admin)
+        .send()
+        .await;
+    resp.assert_status_is_ok();
+    let resp = cli
+        .get("/api/v1/current-user")
+        .header("Authorization", format!("Bearer {token}"))
+        .send()
+        .await;
+    assert!(!resp.0.status().is_success(), "token gone with its account");
+}
+
+#[tokio::test]
+async fn service_account_create_is_validated() {
+    setup().await;
+    let admin = format!("Bearer {}", admin_token().await);
+    let cli = client();
+    let account_role = bichon_core::users::role::UserRole::list_all()
+        .unwrap()
+        .into_iter()
+        .find(|r| r.role_type == bichon_core::users::role::RoleType::Account)
+        .unwrap()
+        .id;
+
+    for body in [
+        json!({ "username": "ab" }),
+        json!({ "username": "x".repeat(33) }),
+        json!({ "username": "svc-desc", "description": "d".repeat(257) }),
+        json!({ "username": "svc-role", "global_roles": [account_role] }),
+        json!({ "username": "svc-acc", "account_access_map": { "424242": account_role } }),
+        json!({ "username": "svc-acl", "acl": { "ip_whitelist": ["not-an-ip"] } }),
+    ] {
+        let resp = cli
+            .post("/api/v1/service-accounts")
+            .header("Authorization", &admin)
+            .body_json(&body)
+            .send()
+            .await;
+        assert!(!resp.0.status().is_success(), "accepted {body}");
+    }
+
+    // A system role is fine.
+    let resp = cli
+        .post("/api/v1/service-accounts")
+        .header("Authorization", &admin)
+        .body_json(&json!({ "username": "svc-admin", "global_roles": [ADMIN_ROLE_ID] }))
+        .send()
+        .await;
+    resp.assert_status_is_ok();
+
+    // Without USER_MANAGE: no token at all here.
+    let resp = cli
+        .post("/api/v1/service-accounts")
+        .body_json(&json!({ "username": "svc-anon" }))
+        .send()
+        .await;
+    assert!(!resp.0.status().is_success());
+}
+
+#[tokio::test]
+async fn service_account_guards() {
+    setup().await;
+    let svc = UserModel {
+        username: "svc".into(),
+        service_account: true,
+        ..Default::default()
+    };
+    let person = UserModel {
+        username: "person".into(),
+        ..Default::default()
+    };
+
+    assert!(service::check_token(&svc, &TokenType::Api).is_ok());
+    assert!(service::check_token(&svc, &TokenType::WebUI).is_err());
+    assert!(service::check_token(&person, &TokenType::WebUI).is_ok());
+
+    assert!(service::refuse_login(&person).is_none());
+    let refused = service::refuse_login(&svc).unwrap();
+    assert!(!refused.success && refused.access_token.is_none());
+
+    // Unknown ids and ordinary users are not the guard's business.
+    let password = UserUpdateRequest {
+        password: Some("secret-password".into()),
+        ..Default::default()
+    };
+    assert!(service::check_update(1, &password).is_ok());
+    assert!(service::check_update(DEFAULT_ADMIN_USER_ID, &UserUpdateRequest::default()).is_ok());
+
+    let created = service::create(ServiceAccountCreateRequest {
+        username: "svc-core".into(),
+        ..Default::default()
+    })
+    .unwrap();
+    assert!(service::check_update(created.id, &password).is_err());
+    assert!(service::check_update(created.id, &UserUpdateRequest::default()).is_ok());
+    UserModel::remove(created.id).unwrap();
+}
+
+#[test]
+fn records_without_the_field_are_people() {
+    let user: UserModel = serde_json::from_value(json!({
+        "id": 1, "username": "old", "email": "old@example.com", "password": null,
+        "account_access_map": {}, "description": null, "global_roles": [],
+        "avatar": null, "created_at": 0, "updated_at": 0, "acl": null,
+        "theme": null, "language": null, "sso_id": null, "sso_provider": null
+    }))
+    .unwrap();
+    assert!(!user.service_account);
+}
