diff --git a/crates/core/src/users/service.rs b/crates/core/src/users/service.rs
new file mode 100644
index 0000000..5f441a4
--- /dev/null
+++ b/crates/core/src/users/service.rs
@@ -0,0 +1,155 @@
+//
+// Copyright (c) 2025-2026 rustmailer.com (https://rustmailer.com)
+//
+// This file is part of the Bichon Email Archiving Project
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Affero General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU Affero General Public License for more details.
+//
+// You should have received a copy of the GNU Affero General Public License
+// along with this program.  If not, see <http://www.gnu.org/licenses/>.
+
+//! svesh: service accounts — users for API tokens only.
+//!
+//! An agent or a script needs a token with a narrow set of rights, not a
+//! person with an e-mail and a password. A service account is a regular user
+//! record (`service_account = true`), so roles, account access and ACL work as
+//! for everyone, but it has no e-mail and no password, gets no WebUI token and
+//! cannot log in: the only way in is an API token issued for it by a user
+//! manager.
+
+use crate::{
+    account::migration::AccountModel,
+    database::{find_impl, insert_impl, manager::DB_MANAGER},
+    error::{code::ErrorCode, BichonResult},
+    id, raise_error,
+    token::TokenType,
+    users::{
+        acl::AccessControl,
+        payload::UserUpdateRequest,
+        role::{RoleType, UserRole},
+        LoginResult, UserModel,
+    },
+    utc_now,
+};
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, HashMap};
+
+#[derive(Clone, Debug, Default, Eq, PartialEq, Deserialize, Serialize)]
+#[cfg_attr(feature = "web-api", derive(poem_openapi::Object))]
+pub struct ServiceAccountCreateRequest {
+    pub username: String,
+    pub description: Option<String>,
+    /// System roles; may be empty — account roles are usually enough.
+    #[serde(default)]
+    #[cfg_attr(feature = "web-api", oai(default))]
+    pub global_roles: Vec<u64>,
+    /// Account id → account role id.
+    #[serde(default)]
+    #[cfg_attr(feature = "web-api", oai(default))]
+    pub account_access_map: BTreeMap<u64, u64>,
+    pub acl: Option<AccessControl>,
+}
+
+fn invalid(message: String) -> crate::error::BichonError {
+    raise_error!(message, ErrorCode::InvalidParameter)
+}
+
+impl ServiceAccountCreateRequest {
+    pub fn validate(&self) -> BichonResult<()> {
+        let len = self.username.chars().count();
+        if !(3..=32).contains(&len) {
+            return Err(invalid("Username must be 3 to 32 characters long.".into()));
+        }
+        if self.description.as_ref().is_some_and(|d| d.len() > 256) {
+            return Err(invalid("Description cannot exceed 256 characters.".into()));
+        }
+        let types: HashMap<u64, RoleType> = UserRole::list_all()?
+            .into_iter()
+            .map(|r| (r.id, r.role_type))
+            .collect();
+        for rid in &self.global_roles {
+            if types.get(rid) != Some(&RoleType::Global) {
+                return Err(invalid(format!("Role {rid} is not a system role")));
+            }
+        }
+        for (aid, rid) in &self.account_access_map {
+            if AccountModel::find(*aid)?.is_none() {
+                return Err(invalid(format!("Account {aid} not found")));
+            }
+            if types.get(rid) != Some(&RoleType::Account) {
+                return Err(invalid(format!(
+                    "Role {rid} for account {aid} is not an account role"
+                )));
+            }
+        }
+        if let Some(acl) = &self.acl {
+            acl.validate()?;
+        }
+        Ok(())
+    }
+}
+
+/// Creates a service account. Unlike a user it gets no WebUI token: tokens
+/// are issued for it through the access token API.
+pub fn create(request: ServiceAccountCreateRequest) -> BichonResult<UserModel> {
+    request.validate()?;
+    UserModel::check_username_conflict(&request.username)?;
+    let now = utc_now!();
+    let user = UserModel {
+        id: id!(96),
+        username: request.username,
+        description: request.description,
+        global_roles: request.global_roles,
+        account_access_map: request.account_access_map,
+        acl: request.acl,
+        created_at: now,
+        updated_at: now,
+        service_account: true,
+        ..Default::default()
+    };
+    insert_impl(DB_MANAGER.db(), user.clone())?;
+    Ok(user)
+}
+
+/// The login answer for a service account; `None` for everyone else.
+pub fn refuse_login(user: &UserModel) -> Option<LoginResult> {
+    user.service_account.then(|| LoginResult {
+        error_message: Some(format!(
+            "'{}' is a service account: it has no login, use an API token.",
+            user.username
+        )),
+        ..Default::default()
+    })
+}
+
+/// A service account gets no password and no e-mail.
+pub fn check_update(id: u64, request: &UserUpdateRequest) -> BichonResult<()> {
+    let Some(user) = find_impl::<UserModel>(DB_MANAGER.db(), &id.to_string())? else {
+        return Ok(());
+    };
+    if user.service_account && (request.password.is_some() || request.email.is_some()) {
+        return Err(invalid(
+            "A service account has no password or e-mail.".into(),
+        ));
+    }
+    Ok(())
+}
+
+/// Only API tokens act for a service account.
+pub fn check_token(user: &UserModel, token_type: &TokenType) -> BichonResult<()> {
+    if user.service_account && *token_type != TokenType::Api {
+        return Err(raise_error!(
+            "Service accounts accept API tokens only.".into(),
+            ErrorCode::PermissionDenied
+        ));
+    }
+    Ok(())
+}
