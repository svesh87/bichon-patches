+//! svesh: create service accounts (`bichon_core::users::service`). They are
+//! listed, edited, removed and get tokens through the regular user and access
+//! token APIs.
+
+use std::collections::BTreeMap;
+
+use crate::common::auth::WrappedContext;
+use crate::rest::api::ApiTags;
+use crate::rest::ApiResult;
+use bichon_core::ext::event_bus::{emit, Event};
+use bichon_core::users::permissions::Permission;
+use bichon_core::users::role::UserRole;
+use bichon_core::users::service::{self, ServiceAccountCreateRequest};
+use bichon_core::users::view::UserView;
+use poem_openapi::payload::Json;
+use poem_openapi::OpenApi;
+
+pub struct ServiceAccountsApi;
+
+#[OpenApi(prefix_path = "/api/v1", tag = "ApiTags::Users")]
+impl ServiceAccountsApi {
+    /// Create a service account: a user for API tokens only, without e-mail,
+    /// password and WebUI login.
+    #[oai(
+        path = "/service-accounts",
+        method = "post",
+        operation_id = "create_service_account"
+    )]
+    async fn create_service_account(
+        &self,
+        payload: Json<ServiceAccountCreateRequest>,
+        context: WrappedContext,
+    ) -> ApiResult<Json<UserView>> {
+        context.require_permission(None, Permission::USER_MANAGE)?;
+        let user = service::create(payload.0)?;
+        emit(Event::UserCreated {
+            created_by: context.user.username.clone(),
+            new_user: user.username.clone(),
+        });
+        let roles: BTreeMap<u64, UserRole> = UserRole::list_all()?
+            .into_iter()
+            .map(|r| (r.id, r))
+            .collect();
+        Ok(Json(user.to_view(&roles)))
+    }
+}
