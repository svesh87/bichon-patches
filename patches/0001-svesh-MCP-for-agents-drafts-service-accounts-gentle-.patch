@@ -0,0 +1,33 @@
+// svesh fork: the service account form (no e-mail or password, system roles optional).
+import { describe, it, expect } from 'vitest'
+import { getServiceAccountSchema } from '../schema'
+
+const t = (key: string) => key
+const schema = getServiceAccountSchema(t)
+const valid = { username: 'mcp', email: '', password: '', global_roles: [] }
+
+describe('getServiceAccountSchema', () => {
+  it('accepts an account without e-mail, password and system roles', () => {
+    expect(schema.safeParse(valid).success).toBe(true)
+  })
+
+  it('keeps account access entries', () => {
+    const result = schema.safeParse({
+      ...valid,
+      account_access_entries: [{ accountId: 7, roleId: 3 }],
+    })
+    expect(result.success && result.data.account_access_entries).toEqual([
+      { accountId: 7, roleId: 3 },
+    ])
+  })
+
+  it.each([
+    ['short username', { ...valid, username: 'ab' }],
+    ['long username', { ...valid, username: 'a'.repeat(33) }],
+    ['long description', { ...valid, description: 'd'.repeat(257) }],
+    ['incomplete account entry', { ...valid, account_access_entries: [{ accountId: 0, roleId: 3 }] }],
+    ['bad IP', { ...valid, acl: { ip_whitelist: 'not-an-ip' } }],
+  ])('rejects %s', (_, data) => {
+    expect(schema.safeParse(data).success).toBe(false)
+  })
+})
