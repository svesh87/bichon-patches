+        account_id,
+        name: "Drafts".into(),
+        delimiter: Some("/".into()),
+        ..Default::default()
+    }])
+    .unwrap();
+    let folder = append_draft(account_id, Some("Drafts"), b"Subject: x\r\n\r\ny")
+        .await
+        .unwrap();
+    assert_eq!(folder, "Drafts");
+    assert!(!appended.lock().unwrap().is_empty());
