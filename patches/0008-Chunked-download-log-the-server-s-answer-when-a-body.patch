From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sergei Sveshnikov <sergei@svesh.dev>
Date: Fri, 30 Oct 2026 17:15:51 +0100
Subject: [PATCH 08/10] Chunked download: log the server's answer when a body
 never comes

The FETCH stream of async-imap stops at the command's tagged status and
drops it, so a refusal (NO [...] text) looked like an empty answer. When a
message's body comes neither in parts nor whole (and for the first missing
one of a group) a one-byte UID FETCH is run with run_command_and_check_ok
and its result is logged with the warning.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/core/src/imap/chunked.rs       | 29 +++++++++++++++++++++++++++
 crates/core/src/imap/chunked_tests.rs | 14 +++++++++++++
 2 files changed, 43 insertions(+)

diff --git a/crates/core/src/imap/chunked.rs b/crates/core/src/imap/chunked.rs
index 6641a78..3bd42d3 100644
--- a/crates/core/src/imap/chunked.rs
+++ b/crates/core/src/imap/chunked.rs
@@ -103,9 +103,11 @@ pub async fn fetch_message_in_chunks(
     }
     let whole = fetch_group(session, &[(uid, size)]).await?;
     if whole.is_empty() {
+        let server = probe(session, uid).await;
         tracing::warn!(
             uid,
             size,
+            server,
             "No body for the message, neither in parts nor whole"
         );
     } else {
@@ -118,6 +120,19 @@ pub async fn fetch_message_in_chunks(
     Ok(whole.into_iter().next().map(|(_, body, date)| (body, date)))
 }
 
+/// What the server says to a one-byte fetch of `uid`: the FETCH stream drops
+/// the command's final status, so a refusal (`NO [...] text`) is otherwise
+/// invisible. For the log only.
+pub async fn probe(session: &mut Session<Box<dyn SessionStream>>, uid: u32) -> String {
+    match session
+        .run_command_and_check_ok(format!("UID FETCH {uid} (UID BODY.PEEK[]<0.1>)"))
+        .await
+    {
+        Ok(()) => "OK (the server answers, but sent no body)".to_string(),
+        Err(e) => format!("{e:?}"),
+    }
+}
+
 async fn fetch_parts(
     session: &mut Session<Box<dyn SessionStream>>,
     uid: u32,
@@ -339,10 +354,24 @@ pub async fn retrieve_in_chunks(
         if fetched.len() < expected {
             let missing = expected - fetched.len();
             outcome.parse_skipped += missing as u64;
+            // The server's word on the first missing one of a group (a single
+            // message was probed in fetch_message_in_chunks already).
+            let server = match &step {
+                Step::Group(group) => {
+                    let got: std::collections::HashSet<u32> =
+                        fetched.iter().map(|(uid, ..)| *uid).collect();
+                    match group.iter().find(|(uid, _)| !got.contains(uid)) {
+                        Some((uid, _)) => probe(session, *uid).await,
+                        None => String::new(),
+                    }
+                }
+                Step::Single(..) => String::new(),
+            };
             tracing::warn!(
                 account_id,
                 mailbox_id,
                 missing,
+                server,
                 "No body from the server for some messages: not archived, gap-fill will retry"
             );
             session_error(
diff --git a/crates/core/src/imap/chunked_tests.rs b/crates/core/src/imap/chunked_tests.rs
index 44d9f76..dc7c0e7 100644
--- a/crates/core/src/imap/chunked_tests.rs
+++ b/crates/core/src/imap/chunked_tests.rs
@@ -308,3 +308,17 @@ async fn retrieve_groups_small_messages() {
     .await;
     assert!(!matches!(result, Ok(Ok(_))));
 }
+
+#[tokio::test]
+async fn probe_shows_the_servers_refusal() {
+    // The FETCH stream drops the final status; the probe reads it.
+    let handle = mock()
+        .respond("UID FETCH 8 ", "{TAG} NO [UNAVAILABLE] Try again later\r\n")
+        .respond("UID FETCH 9 ", "{TAG} OK FETCH done\r\n")
+        .start()
+        .await;
+    let mut s = session(&handle).await;
+    let refused = probe(&mut s, 8).await;
+    assert!(refused.contains("Try again later"), "{refused}");
+    assert!(probe(&mut s, 9).await.starts_with("OK"));
+}
